---
import { site } from '../config.ts';
import { PACKS, inPack, demos } from '../demos/index.ts';
import { THEMES } from '../theme.ts';
import Mini from './Mini.astro';
import Logo from './Logo.astro';
import Flag from './Flag.astro';
import { BASE, toPlayground } from '../lib/links.ts';
import { ICONS, VIEWS } from './demo/chrome.ts';
import { highlight } from '../lib/highlight.ts';

// the library's own figures, short enough to read at a glance; the first is the letter swap and a click on shuffle picks any other
const MAX_LINES = 16, FIRST = 'core/reorder';
const pool = demos.flatMap((d) => {
  const code = d.code(d.defaults).trim();
  return d.id === FIRST || code.split('\n').length <= MAX_LINES ? [{ id: d.id, title: d.title, pack: d.pack, code }] : [];
});
const first = pool.find((d) => d.id === FIRST) ?? pool[0];
const showcase = Object.fromEntries(pool.map((d) => [d.id, { title: d.title, pack: d.pack, html: highlight(d.code), href: toPlayground(d.code) }]));

const reel = [
  { id: 'devices/laptop', title: 'Devices', text: 'Monitors, laptops, routers, a keyboard.', spin: 10 },
  { id: 'core/typing', title: 'Animation', text: 'Scrub, pause, render one frame.' },
  { id: 'waves/interference', title: 'Waves and optics', text: 'Sonar, stereo rigs, lenses.' },
  { id: 'ui/loading', title: 'Interfaces', text: 'Progress, chat and dialogs on screens.' },
  { id: 'flow/decision', title: 'Graphs and flow', text: 'Flowcharts, trees and networks that place themselves.' },
];
const features = [
  { n: '01', title: 'One space for 2D and 3D', text: 'x to the right, y into the scene, z up. A flat diagram is a scene seen from the front.' },
  { n: '02', title: 'Real SVG', text: 'It follows your CSS, renders on the server, and plays live in the browser. Nothing to rasterise.' },
  { n: '03', title: 'A scene is a function of time', text: 'Playing, pausing, stepping and rendering a single frame all work the same way.' },
  { n: '04', title: 'Pick what you use', text: 'The core is small. Every pack has its own import, so a page that needs a monitor does not load the charts.' },
  { n: '05', title: 'Ready-made parts', text: 'Monitors, laptops, routers, charts, waves, lenses, graphs and flowcharts are built in. Place them, do not draw them.' },
  { n: '06', title: 'Camera and orbit', text: 'Parallel or perspective, and the camera animates like anything else. Let readers drag to turn, zoom and reset.' },
  { n: '07', title: 'Follows your theme', text: 'Set up to three CSS variables on a figure or any parent, and every colour is derived from them. Light and dark come with it.' },
  { n: '08', title: 'Show how it is made', text: 'Build a drawing from guides, circles and outlines that trace on, fill and turn, then take it apart again. The cube above is built this way.' },
];
const path = [
  { n: 1, title: 'Install', text: 'One package, one stylesheet.', href: '/start/install/' },
  { n: 2, title: 'Your first scene', text: 'Draw, animate and embed in ten minutes.', href: '/start/first-scene/' },
  { n: 3, title: 'Theme it', text: 'The three-variable contract behind every colour.', href: '/concepts/theming/' },
  { n: 4, title: 'Look things up', text: 'Every export, generated from the code.', href: '/reference/core/' },
];
---
<Flag name="cn-landing" />
<div class="landing">
  <section class="hero">
    <div class="hero-text">
      <p class="eyebrow">SVG · 2D and 3D · themeable</p>
      <div class="hero-brand"><Logo variant="mark" class="hero-mark" label="" /><h1>{site.name}</h1></div>
      <p class="tagline">{site.tagline}</p>
      <p class="lede">Describe a scene in a few lines of TypeScript, animate it on a timeline, and put it on a page. It draws real SVG, so it follows your CSS, renders on the server, and plays live in the browser.</p>
      <div class="install-line"><code>npm install {site.pkg}</code><button type="button" data-copy={`npm install ${site.pkg}`}>Copy</button></div>
      <div class="actions">
        <a class="btn primary" href={`${BASE}/start/introduction/`}>Get started</a>
        <a class="btn" href={`${BASE}/playground/`}>Open the playground</a>
        <a class="link" href={`${BASE}/gallery/core/`}>Browse the gallery →</a>
      </div>
    </div>
    <div class="hero-fig"><Mini id="core/cube-build" flat tight cell={2} quiet label="The cseen cube, built on the ground: six squares are outlined, each gets a letter (c, s, e, e, n and a second c), then the flat net folds shut into a cube that turns on its base and unfolds again." /></div>
  </section>

  <section class="reel" aria-labelledby="reel-h">
    <h2 id="reel-h">See it move</h2>
    <ul class="reel-row">
      {reel.map((f) => (
        <li>
          <div class="figure"><Mini id={f.id} spin={f.spin ?? 0} /></div>
          <h3>{f.title}</h3>
          <p>{f.text}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="install" data-showcase>
    <div class="install-head">
      <h2>A scene in a few lines</h2>
      <div class="shuffle-bar">
        <span class="show-name" aria-live="polite"><strong data-show-title>{first.title}</strong><small data-show-pack>{first.pack}</small></span>
        <button type="button" class="shuffle" data-shuffle aria-label="Show another scene" title="Show another scene">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 3h5v5" /><path d="M4 20 21 3" /><path d="M21 16v5h-5" /><path d="m15 15 6 6" /><path d="M4 4l5 5" /></svg>
          <span>Shuffle</span>
        </button>
      </div>
    </div>
    <div class="show">
      <div class="pane dm">
        <div class="pane-bar"><span class="pane-tab">scene.ts</span><button type="button" class="pane-fs" data-pane-full aria-pressed="false" aria-label="Full screen: code" title="Full screen: code" set:html={ICONS.full} /></div>
        <pre class="code show-code" tabindex="0"><code data-show-code set:html={highlight(first.code)} /></pre>
      </div>
      <div class="pane dm">
        <div class="pane-bar">
          <span class="pane-tab">Preview</span>
          <span class="pane-end"><a class="run" data-show-run href={toPlayground(first.code)}>Run in the playground →</a><button type="button" class="pane-fs" data-pane-full aria-pressed="false" aria-label="Full screen: preview" title="Full screen: preview" set:html={ICONS.full} /></span>
        </div>
        <div class="show-fig">
          <div class="stage" data-show-fig><Mini id={first.id} still /></div>
        </div>
        <div class="dm-tools">
          <div class="dm-views" role="group" aria-label="View">
            {VIEWS.map(([k, t]) => <button type="button" data-show-view={k} aria-pressed="false">{t}</button>)}
          </div>
          <div class="dm-play" role="group" aria-label="Playback" data-show-playbar hidden>
            <button type="button" data-show-play aria-label="Pause" title="Play or pause" set:html={ICONS.pause} />
            <input type="range" data-show-scrub min="0" max="1" step="0.01" value="0" aria-label="Time" />
            <span class="dm-clock" data-show-clock aria-hidden="true"></span>
          </div>
        </div>
      </div>
    </div>
    <div class="theme-bar">
      <p class="theme-note"><strong>Try it in any theme.</strong> Three CSS variables and everything else, the figure included, is derived from them.</p>
      <div class="theme-tools" role="group" aria-label="Theme">
        <button type="button" class="mode" data-mode aria-label="Switch between light and dark" title="Light or dark">
          <svg class="sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg class="moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
          <span class="mode-label"><span class="on-light">Light</span><span class="on-dark">Dark</span></span>
        </button>
        <span class="tools-sep" aria-hidden="true"></span>
        <ul class="themes">
          {Object.entries(THEMES).map(([k, t]) => (
            <li><button type="button" data-family={k} aria-label={t.label} aria-pressed="false" data-lb={t.light.bg.toLowerCase()} data-la={t.light.accent.toLowerCase()} data-db={t.dark.bg.toLowerCase()} data-da={t.dark.accent.toLowerCase()} style={`--lb:${t.light.bg};--la:${t.light.accent};--db:${t.dark.bg};--da:${t.dark.accent}`}><i></i><span class="nm">{t.label}</span></button></li>
          ))}
          <li><button type="button" data-theme-random aria-label="Random theme" title="Random theme"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8.5" cy="8.5" r="1" fill="currentColor"/><circle cx="15.5" cy="15.5" r="1" fill="currentColor"/><circle cx="12" cy="12" r="1" fill="currentColor"/></svg><span class="lbl">Random</span></button></li>
        </ul>
      </div>
    </div>
    <script type="application/json" data-showcase-data set:html={JSON.stringify(showcase).replace(/</g, '\\u003c')} />
  </section>

  <section class="features">
    <h2>What it does</h2>
    <ul class="feature-grid">
      {features.map((f) => (
        <li class="feature"><span class="num">{f.n}</span><h3>{f.title}</h3><p>{f.text}</p></li>
      ))}
    </ul>
  </section>

  <section class="packs">
    <h2>Pick what you use</h2>
    <ul class="pack-grid">
      {PACKS.filter((p) => p.lib !== false).map((p) => (
        <li><a href={`${BASE}/gallery/${p.id}/`}><strong>{p.title}</strong><span>{p.blurb}</span><small>{inPack(p.id).length} in the gallery</small></a></li>
      ))}
    </ul>
  </section>

  <section class="more">
    <h2>Learn it in four steps</h2>
    <ol class="more-grid">
      {path.map((p) => (
        <li><a href={`${BASE}${p.href}`}><span class="step">{p.n}</span><strong>{p.title}</strong><span>{p.text}</span></a></li>
      ))}
    </ol>
  </section>
</div>

<script>
  import { startTrail } from '../scripts/trail';
  import { scrubberSync } from '../lib/scrubber.ts';
  import { ICONS } from './demo/chrome.ts';
  const heroEl = document.querySelector<HTMLElement>('.landing .hero');
  if (heroEl) startTrail(heroEl);
  // the theme editor in the header owns the theme; these buttons only ask it
  // a random palette survives a reload (the theme editor keeps its seed), so the button can show it is the one in use
  let randomPicked = false;
  try { randomPicked = !!localStorage.getItem('cseen-seed'); } catch { /* ignore */ }
  document.querySelectorAll<HTMLButtonElement>('[data-family]').forEach((b) => b.addEventListener('click', () => { randomPicked = false; document.dispatchEvent(new CustomEvent('cseen-set-family', { detail: b.dataset.family })); }));
  document.querySelector('[data-mode]')?.addEventListener('click', () => document.dispatchEvent(new CustomEvent('cseen-flip-mode')));
  const randomBtn = document.querySelector<HTMLButtonElement>('[data-theme-random]');
  randomBtn?.addEventListener('click', () => { randomPicked = true; document.dispatchEvent(new CustomEvent('cseen-random-theme')); randomBtn.setAttribute('aria-pressed', 'true'); });

  // mark the family whose colours the page is wearing; a hand-picked or random palette marks none
  const famBtns = [...document.querySelectorAll<HTMLButtonElement>('[data-family]')];
  const markFamily = () => {
    const root = document.documentElement, cs = getComputedStyle(root);
    const dark = root.dataset.theme === 'dark';
    const bg = cs.getPropertyValue('--cn-bg').trim().toLowerCase(), ac = cs.getPropertyValue('--cn-accent').trim().toLowerCase();
    let any = false;
    famBtns.forEach((b) => { const on = b.dataset[dark ? 'db' : 'lb'] === bg && b.dataset[dark ? 'da' : 'la'] === ac; any ||= on; b.setAttribute('aria-pressed', String(on)); });
    if (any) randomPicked = false;
    randomBtn?.setAttribute('aria-pressed', String(randomPicked && !any));
  };
  document.documentElement.addEventListener('cseen-theme', markFamily);
  markFamily();
  requestAnimationFrame(markFamily);

  const box = document.querySelector<HTMLElement>('[data-showcase]');
  if (box) {
    const data: Record<string, { title: string; pack: string; html: string; href: string }> = JSON.parse(box.querySelector('[data-showcase-data]')!.textContent!);
    const ids = Object.keys(data);
    let cur = box.querySelector<HTMLElement>('[data-show-fig] [data-id]')?.dataset.id ?? '';
    const fig = box.querySelector<HTMLElement>('[data-show-fig]')!;
    const playBtn = box.querySelector<HTMLButtonElement>('[data-show-play]')!;
    const playBar = box.querySelector<HTMLElement>('[data-show-playbar]')!;
    const scrub = box.querySelector<HTMLInputElement>('[data-show-scrub]')!;
    const clock = box.querySelector<HTMLElement>('[data-show-clock]')!;
    const viewBtns = [...box.querySelectorAll<HTMLButtonElement>('[data-show-view]')];
    // the figure covers its pane: a scene whose ratio differs from the pane's is cropped at the edges instead of leaving bands of empty space
    const cover = () => fig.querySelector('svg')?.setAttribute('preserveAspectRatio', 'xMidYMid slice');
    new MutationObserver(cover).observe(fig, { childList: true, subtree: true });
    cover();

    // the figure comes alive when it scrolls near, and again with every shuffle; the chosen view is kept from scene to scene
    let preset: string | null = null, player: { playing: boolean; time: number; duration: number; play(): void; pause(): void; seek(t: number): void; destroy(): void; invalidate(): void } | undefined, orb: { destroy(): void } | undefined, token = 0;
    const syncPlay = () => {
      playBtn.innerHTML = player?.playing ? ICONS.pause : ICONS.play;
      playBtn.setAttribute('aria-label', player?.playing ? 'Pause' : 'Play');
    };
    const syncViews = () => viewBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.showView === preset)));
    const bringToLife = async (id: string) => {
      const mine = ++token;
      const [lib, { byId }, { prepare }, { applyPreset }] = await Promise.all([import('cseen'), import('../demos/index.ts'), import('../demos/prepare.ts'), import('./demo/window.ts')]);
      const d = byId.get(id);
      if (!d || mine !== token) return;
      const made = prepare(d.make(d.defaults), d);
      if (preset) applyPreset(made.s, preset);
      const home = made.s.camera.snapshot();
      orb?.destroy();
      player?.destroy();
      const host = document.createElement('div');
      host.dataset.id = id;
      host.setAttribute('role', 'group');
      host.setAttribute('aria-label', d.title);
      fig.replaceChildren(host);
      const p = lib.mount(host, made.s, { timeline: made.tl, loop: { pause: 1.2 }, onlyVisible: true });
      player = p;
      const svg = host.querySelector('svg')!;
      orb = lib.orbit(svg, made.s, { home, onChange: () => p.invalidate() });
      // a figure must not trap scrolling: wheel and touch drags go to the page, pinch (ctrl+wheel) still zooms, a mouse still drags to turn
      svg.style.touchAction = 'pan-x pan-y pinch-zoom';
      svg.addEventListener('wheel', (e) => { if (!e.ctrlKey) e.stopImmediatePropagation(); }, { capture: true, passive: true });
      playBar.hidden = !made.tl;
      scrub.max = String(made.tl?.duration ?? 1);
      syncPlay();
      syncViews();
    };
    playBtn.addEventListener('click', () => {
      if (!player) return;
      if (player.playing) player.pause(); else { if (player.time >= player.duration - 0.01) player.seek(0); player.play(); }
      syncPlay();
    });
    scrub.addEventListener('input', () => { if (!player) return; player.pause(); player.seek(Number(scrub.value)); syncPlay(); });
    const sync = scrubberSync(scrub, clock);
    const tick = () => {
      requestAnimationFrame(tick);
      if (!player || playBar.hidden) return;
      sync(player, document.activeElement === scrub);
    };
    requestAnimationFrame(tick);
    viewBtns.forEach((b) => b.addEventListener('click', () => { preset = b.dataset.showView!; void bringToLife(cur); }));
    new IntersectionObserver((e, io) => { if (e.some((x) => x.isIntersecting)) { io.disconnect(); void bringToLife(cur); } }, { rootMargin: '150px' }).observe(box);

    const shuffle = () => {
      if (ids.length < 2) return;
      let id = cur;
      while (id === cur) id = ids[Math.floor(Math.random() * ids.length)];
      cur = id;
      const d = data[id];
      box.querySelector('[data-show-code]')!.innerHTML = d.html;
      box.querySelector('[data-show-title]')!.textContent = d.title;
      box.querySelector('[data-show-pack]')!.textContent = d.pack;
      box.querySelector<HTMLAnchorElement>('[data-show-run]')!.href = d.href;
      void bringToLife(id);
    };
    box.querySelector('[data-shuffle]')?.addEventListener('click', shuffle);

    // full screen for either pane; the button swaps to its exit icon while its pane is up
    const fsBtns = [...box.querySelectorAll<HTMLButtonElement>('[data-pane-full]')];
    fsBtns.forEach((b) => b.addEventListener('click', () => {
      const pane = b.closest<HTMLElement>('.pane')!;
      if (document.fullscreenElement === pane) void document.exitFullscreen(); else void pane.requestFullscreen?.();
    }));
    document.addEventListener('fullscreenchange', () => fsBtns.forEach((b) => {
      const on = document.fullscreenElement === b.closest('.pane'), what = b.getAttribute('aria-label')!.split(': ')[1];
      b.setAttribute('aria-pressed', String(on));
      b.setAttribute('aria-label', `${on ? 'Exit full screen' : 'Full screen'}: ${what}`);
      b.title = b.getAttribute('aria-label')!;
      b.innerHTML = on ? ICONS.exitFull : ICONS.full;
    }));
  }

  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => b.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(b.dataset.copy!); } catch { return; }
    const t = b.textContent; b.textContent = 'Copied'; setTimeout(() => { b.textContent = t; }, 1400);
  }));
</script>


<style is:global>
  /* the landing page has its own heading, so Starlight's empty title strip goes */
  :root.cn-landing .content-panel:first-of-type { display: none; }
  /* and the rule Starlight draws between its two panels would be a stray line under the header */
  :root.cn-landing .content-panel { border-top: 0; }
</style>
<style>
  .landing { display: grid; grid-template-columns: minmax(0, 1fr); gap: 5rem; padding-block: 1rem 3rem; }
  .landing > :global(*) { min-width: 0; }
  .landing :global(h2) { font-family: var(--cn-font-display); font-weight: 700; letter-spacing: 0; font-size: clamp(1.4rem, 3vw, 1.9rem); margin: 0 0 1rem; color: var(--sl-color-white); }
  .eyebrow { margin: 0 0 0.8rem; font-family: var(--sl-font-mono); font-size: var(--sl-text-xs); text-transform: uppercase; letter-spacing: 0.1em; color: var(--sl-color-gray-3); }
  .hero { position: relative; display: grid; grid-template-columns: minmax(0, 1fr); gap: 2rem; align-items: center; }
  .hero > :global(.cn-trail) { position: absolute; inset: 0; width: 100%; height: 100%; max-width: none; pointer-events: none; z-index: 0; mask-image: linear-gradient(to bottom, #000 calc(100% - 160px), transparent); }
  .hero-text, .hero-fig { position: relative; z-index: 1; }
  .hero-brand { display: flex; align-items: center; gap: clamp(0.8rem, 2vw, 1.4rem); }
  .hero-brand :global(.hero-mark) { height: clamp(3.4rem, 9vw, 5.6rem); flex: none; }
  .hero h1 { font-family: var(--cn-font-display); font-weight: 700; font-size: clamp(3rem, 9vw, 5.6rem); line-height: 1; margin: 0; color: var(--sl-color-white); letter-spacing: 0; }
  .tagline { font-size: var(--sl-text-xl); color: var(--sl-color-white); margin: 1rem 0 0; line-height: 1.3; }
  .lede { color: var(--sl-color-gray-2); margin: 1rem 0 1.4rem; max-width: 34rem; }
  .install-line { display: inline-flex; align-items: center; gap: 0.8rem; padding: 0.35rem 0.4rem 0.35rem 0.9rem; margin-bottom: 1.2rem; border: 1px solid var(--sl-color-hairline); border-radius: 0.5rem; background: var(--sl-color-gray-7); max-width: 100%; }
  .install-line code { font-family: var(--sl-font-mono); font-size: 0.9rem; background: none; padding: 0; color: var(--sl-color-white); overflow-x: auto; white-space: nowrap; }
  .install-line button { padding: 0.25rem 0.7rem; border: 1px solid var(--sl-color-hairline); border-radius: 0.35rem; background: var(--cn-bg); color: var(--sl-color-text); font: inherit; font-size: var(--sl-text-xs); cursor: pointer; min-width: 4rem; }
  .install-line button:hover { border-color: var(--cn-accent); }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.7rem 0.8rem; }
  .btn { display: inline-block; padding: 0.6rem 1.2rem; border: 1px solid var(--sl-color-hairline); border-radius: 0.5rem; color: var(--sl-color-white); text-decoration: none; font-weight: 600; }
  .btn:hover { border-color: var(--cn-accent); }
  .btn.primary { background: var(--cn-accent); border-color: var(--cn-accent); color: var(--cn-bg); }
  .btn:focus-visible, .link:focus-visible { outline: 2px solid var(--cn-accent); outline-offset: 2px; }
  .link { color: var(--sl-color-text-accent); text-decoration: none; font-weight: 600; }
  .link:hover { text-decoration: underline; }
  .hero-fig { border-radius: 0.8rem; overflow: hidden; background: radial-gradient(closest-side, color-mix(in oklab, var(--cn-accent) 10%, transparent), transparent); }
  .hero-fig :global(cseen-mini) { background: transparent; }
  /* the mark lies on a grid seen from above at an angle, so the figure is wider than tall */
  .hero-fig { display: grid; place-items: center; }
  .hero-fig :global(cseen-mini) { width: 100%; }
  .reel-row { list-style: none; padding: 0; margin: 0; display: grid; grid-auto-flow: column; grid-auto-columns: minmax(15rem, 1fr); gap: 1rem; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 0.6rem; }
  .reel-row li { margin: 0; scroll-snap-align: start; }
  .reel-row h3 { margin: 0.7rem 0 0.1rem; font-size: var(--sl-text-lg); color: var(--sl-color-white); }
  .reel-row p { margin: 0; font-size: var(--sl-text-sm); color: var(--sl-color-gray-2); }
  .install-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.6rem 1.5rem; margin-bottom: 1.2rem; }
  .install-head :global(h2) { margin: 0; }
  .install .code { margin: 0; padding: 1rem 1.2rem; border: 1px solid var(--sl-color-hairline); border-radius: 0.6rem; background: var(--sl-color-gray-7); font-family: var(--sl-font-mono); font-size: 0.85rem; line-height: 1.6; overflow-x: auto; }
  .theme-bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.9rem 2rem; margin-top: 1.4rem; padding-top: 1.2rem; border-top: 1px solid var(--sl-color-hairline); }
  .theme-note { flex: 1 1 18rem; max-width: 28rem; margin: 0; line-height: 1.5; font-size: var(--sl-text-sm); color: var(--sl-color-gray-2); }
  .theme-note strong { color: var(--sl-color-white); }
