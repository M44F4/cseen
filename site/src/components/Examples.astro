---
import Flag from './Flag.astro';
// Curated whole scenes. Each opens in the playground with its code.
import { byId } from '../demos/index.ts';
import { thumbStill } from '../lib/thumb.ts';
import { toPlayground } from '../lib/links.ts';
import { exampleIds as ids, exampleAnchor } from '../lib/examples.ts';

const items = ids.map((id) => {
  const d = byId.get(id);
  if (!d) throw new Error(`Unknown demo "${id}" in the examples list`);
  const m = d.make(d.defaults);
  return { d, still: thumbStill(m.s, m.tl), href: toPlayground(d.code(d.defaults)) };
});
---
<Flag name="cn-wide" />
<ul class="gl-grid">
  {items.map(({ d, still, href }) => (
    <li id={exampleAnchor(d.id)}>
      <a class="gl-card" href={href}>
        <span class="gl-thumb" set:html={still} />
        <span class="gl-name">{d.title}</span>
        <span class="gl-sum">{d.summary}</span>
      </a>
    </li>
  ))}
</ul>
<style>
  a.gl-card { text-decoration: none; }
</style>
