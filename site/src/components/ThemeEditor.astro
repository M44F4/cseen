---
// Replaces Starlight's light/dark switch. Any three colours make a theme: the same contract the library uses.
import { THEMES } from '../theme.ts';
---
<theme-editor>
  <button type="button" class="te-mode" aria-label="Switch between light and dark" title="Light or dark">
    <svg class="te-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    <svg class="te-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
  </button>
  <button type="button" class="te-toggle" aria-haspopup="dialog" aria-expanded="false" title="Customise colours">
    <span class="te-chips" aria-hidden="true"><i data-chip="bg"></i><i data-chip="ink"></i><i data-chip="accent"></i></span>
    <span class="te-label">Customise</span>
  </button>
  <div class="te-panel" role="dialog" aria-label="Theme editor" hidden>
    <div class="te-presets" role="group" aria-label="Themes">
      {Object.entries(THEMES).map(([k, t]) => <button type="button" data-preset={k} aria-label={t.label} title={t.label} style={`--lb:${t.light.bg};--la:${t.light.accent};--db:${t.dark.bg};--da:${t.dark.accent}`}><i></i><span class="nm">{t.label}</span></button>)}
      <button type="button" data-random class="te-icon" aria-label="Random theme" title="Random theme"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8.5" cy="8.5" r="1" fill="currentColor"/><circle cx="15.5" cy="15.5" r="1" fill="currentColor"/><circle cx="12" cy="12" r="1" fill="currentColor"/></svg></button>
      <button type="button" data-reset class="te-icon" aria-label="Reset theme" title="Reset theme"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg></button>
    </div>
    <div class="te-pickers">
      <label><input type="color" data-k="ink" /> Ink</label>
      <label><input type="color" data-k="bg" /> Background</label>
      <label><input type="color" data-k="accent" /> Accent</label>
    </div>
    <p class="te-note">Everything on this site, figures included, is derived from these three colours.</p>
  </div>
</theme-editor>

<style>
  theme-editor { position: relative; display: inline-flex; align-items: center; gap: 0.4rem; }
  .te-mode { display: grid; place-items: center; width: 2.2rem; height: 2.2rem; border: 1px solid var(--sl-color-hairline); border-radius: 0.4rem; background: transparent; color: var(--sl-color-text); cursor: pointer; }
  .te-mode:hover { border-color: var(--cn-accent); }
  .te-moon { display: none; }
  :global(:root[data-theme='dark']) .te-sun { display: none; }
  :global(:root[data-theme='dark']) .te-moon { display: block; }
  .te-toggle { display: flex; align-items: center; gap: 0.5rem; padding: 0.3rem 0.6rem; border: 1px solid var(--sl-color-hairline); border-radius: 999px; background: transparent; color: var(--sl-color-text); font: inherit; font-size: var(--sl-text-sm); cursor: pointer; }
  .te-toggle:hover { border-color: var(--sl-color-gray-3); }
  .te-chips { display: inline-flex; }
  .te-chips i { width: 0.9rem; height: 0.9rem; border-radius: 50%; border: 1px solid var(--sl-color-hairline); margin-inline-end: -0.25rem; }
  .te-chips i[data-chip='bg'] { background: var(--cn-bg); }
  .te-chips i[data-chip='ink'] { background: var(--cn-ink); }
  .te-chips i[data-chip='accent'] { background: var(--cn-accent); }
  .te-panel { position: absolute; inset-inline-end: 0; top: calc(100% + 0.5rem); z-index: 100; width: min(22.5rem, calc(100vw - 2rem)); padding: 0.9rem; border: 1px solid var(--sl-color-hairline); border-radius: 0.6rem; background: var(--sl-color-bg); box-shadow: 0 10px 30px color-mix(in oklab, var(--cn-ink) 18%, transparent); display: grid; gap: 0.75rem; }
  .te-panel[hidden] { display: none; }
  /* in the docs' mobile menu the panel opens in the flow under the buttons, full width, like in the landing page's menu */
  :global(.mobile-preferences) theme-editor { display: contents; }
  :global(.mobile-preferences) .te-mode { width: 2.4rem; height: 2.4rem; }
  :global(.mobile-preferences) .te-toggle { height: 2.4rem; align-self: center; }
  :global(.mobile-preferences) .te-panel { position: static; order: 1; flex: 1 1 100%; width: auto; box-shadow: none; }
  .te-presets { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .te-panel button { padding: 0.25rem 0.6rem; border: 1px solid var(--sl-color-hairline); border-radius: 0.4rem; background: var(--sl-color-gray-7); color: var(--sl-color-text); font: inherit; font-size: var(--sl-text-sm); cursor: pointer; }
  .te-panel button:hover { border-color: var(--cn-accent); }
  .te-panel button[aria-pressed='true'] { border-color: var(--cn-accent); background: color-mix(in oklab, var(--cn-accent) 18%, transparent); font-weight: 600; }
  /* presets are round swatches (the palette's background and accent); the chosen one also shows its name */
  .te-presets button { display: inline-flex; align-items: center; gap: 0; min-height: 2.2rem; padding: 0.2rem 0.4rem; border-radius: 999px; }
  .te-presets button[aria-pressed='true'] { gap: 0.4rem; padding-inline-end: 0.8rem; }
  .te-presets i { width: 1.1rem; height: 1.1rem; border-radius: 50%; border: 1px solid var(--sl-color-hairline); background: linear-gradient(135deg, var(--lb) 50%, var(--la) 50%); }
  :global(:root[data-theme='dark']) .te-presets i { background: linear-gradient(135deg, var(--db) 50%, var(--da) 50%); }
  .te-presets .te-icon { width: 2.2rem; padding: 0; justify-content: center; }
  .te-presets [data-random] { border-style: dashed; }
  .te-presets .nm { display: none; }
  .te-presets button[aria-pressed='true'] .nm { display: inline; }
  .te-pickers { display: grid; gap: 0.4rem; }
  .te-pickers label { display: flex; justify-content: flex-start; gap: 0.75rem; align-items: center; font-size: var(--sl-text-sm); color: var(--sl-color-text); }
  .te-pickers input { width: 3rem; height: 1.8rem; padding: 0; border: 1px solid var(--sl-color-hairline); border-radius: 0.3rem; background: none; cursor: pointer; }
  .te-note { margin: 0; font-size: var(--sl-text-xs); color: var(--sl-color-gray-3); }
  @media (max-width: 50rem) { .te-label { display: none; } }
</style>

<script>
  import { THEMES, randomSeed, fromSeed, isDark, logoFor, type Palette, type Seed } from '../theme';

  const KEY = 'cseen-theme', FAM = 'cseen-family', SEED = 'cseen-seed';
  const root = document.documentElement;
  const keys = ['ink', 'bg', 'accent'] as const;
  let listening = false, family = 'cseen';
  // while a random palette is in use, the light/dark switch gives that palette's other face instead of going back to a family
  let seed: Seed | null = null;

  class ThemeEditor extends HTMLElement {
    connectedCallback() {
      const toggle = this.querySelector<HTMLButtonElement>('.te-toggle')!;
      const panel = this.querySelector<HTMLElement>('.te-panel')!;
      const inputs = Object.fromEntries(keys.map((k) => [k, this.querySelector<HTMLInputElement>(`input[data-k=${k}]`)!])) as Record<(typeof keys)[number], HTMLInputElement>;

      const sync = () => {
        const cs = getComputedStyle(root);
        for (const k of keys) {
          const v = cs.getPropertyValue(`--cn-${k}`).trim();
          if (/^#[0-9a-f]{6}$/i.test(v)) inputs[k].value = v;
        }
        // the preset whose colours are the ones in use, in either face; a random or hand-picked palette matches none
        const cur = keys.map((k) => inputs[k].value.toLowerCase());
        this.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((b) => {
          const t = THEMES[b.dataset.preset!];
          b.setAttribute('aria-pressed', String([t.dark, t.light].some((p) => keys.every((k, i) => p[k].toLowerCase() === cur[i]))));
        });
      };
      // the theme family the light/dark switch stays inside; a hand-picked or random palette keeps the last family
      if (!listening) { try { const f = localStorage.getItem(FAM); if (f && THEMES[f]) family = f; const r = localStorage.getItem(SEED); if (r) { const o = JSON.parse(r); if (Number.isFinite(o.h) && Number.isFinite(o.a)) seed = o; } } catch { /* ignore */ } }
      const face = () => (root.dataset.theme === 'dark' ? 'dark' : 'light') as 'dark' | 'light';
      const apply = (p: Palette, save = true) => {
        root.dataset.theme = p.dark ? 'dark' : 'light';
        for (const k of keys) root.style.setProperty(`--cn-${k}`, p[k]);
        const lg = logoFor(p);
        root.style.setProperty('--cn-logo-a', lg.a); root.style.setProperty('--cn-logo-b', lg.b);
        if (lg.mono) root.dataset.logo = 'mono'; else delete root.dataset.logo;
        try { localStorage.setItem('starlight-theme', p.dark ? 'dark' : 'light'); if (save) localStorage.setItem(KEY, JSON.stringify({ ...p, lg })); } catch { /* storage may be unavailable */ }
        sync();
        root.dispatchEvent(new CustomEvent('cseen-theme', { detail: p }));
      };
      const setSeed = (v: Seed | null) => { seed = v; try { if (v) localStorage.setItem(SEED, JSON.stringify(v)); else localStorage.removeItem(SEED); } catch { /* ignore */ } };
      const random = () => { setSeed(randomSeed()); apply(fromSeed(seed!, face() === 'dark')); };
      const reset = () => {
        setSeed(null);
        for (const k of [...keys, 'logo-a', 'logo-b'] as const) root.style.removeProperty(`--cn-${k}`);
        delete root.dataset.logo;
        family = 'cseen';
        try { localStorage.removeItem(KEY); localStorage.removeItem(FAM); } catch { /* ignore */ }
        sync();
        root.dispatchEvent(new CustomEvent('cseen-theme'));
      };

      // the saved theme is already applied by a small script in the head; read it back into the pickers
      sync();

      const setFamily = (f: string) => { if (!THEMES[f]) return; setSeed(null); family = f; try { localStorage.setItem(FAM, f); } catch { /* ignore */ } apply(THEMES[f][face()]); };
      const flip = () => { const dark = face() !== 'dark'; apply(seed ? fromSeed(seed, dark) : THEMES[family][dark ? 'dark' : 'light']); };
      this.querySelector('.te-mode')!.addEventListener('click', flip);

      const open = (v: boolean) => { panel.hidden = !v; toggle.setAttribute('aria-expanded', String(v)); };
      toggle.addEventListener('click', () => { open(panel.hidden); if (!panel.hidden) { sync(); panel.scrollIntoView({ block: 'nearest' }); } });
      document.addEventListener('click', (e) => { if (!this.contains(e.target as Node)) open(false); });
      this.addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Escape') { open(false); toggle.focus(); } });

      // other parts of the site (the landing page) can ask for a theme
      // the header holds two editors (bar and mobile menu); only the first one answers, or every request would run twice and a flip would cancel itself
      if (!listening) {
        listening = true;
        document.addEventListener('cseen-set-theme', (e) => { setSeed(null); apply((e as CustomEvent<Palette>).detail); });
        document.addEventListener('cseen-set-family', (e) => setFamily((e as CustomEvent<string>).detail));
        document.addEventListener('cseen-flip-mode', flip);
        document.addEventListener('cseen-random-theme', random);
      }
      this.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((b) => b.addEventListener('click', () => setFamily(b.dataset.preset!)));
      for (const k of keys) inputs[k].addEventListener('input', () => {
        setSeed(null);
        apply({ ink: inputs.ink.value, bg: inputs.bg.value, accent: inputs.accent.value, dark: isDark(inputs.bg.value) });
      });
      this.querySelector('[data-random]')!.addEventListener('click', random);
      this.querySelector('[data-reset]')!.addEventListener('click', reset);
    }
  }
  if (!customElements.get('theme-editor')) customElements.define('theme-editor', ThemeEditor);
</script>
